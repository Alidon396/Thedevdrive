# ============================================================================
# TheDevDrive Sahiwal - Environment Variables Template
# Copy this file, rename to .env, and fill in your API keys
# NEVER commit .env to GitHub!
# ============================================================================

# ============================================================================
# SUPABASE - Database
# Get from: https://supabase.com/ → Your Project → Settings → API
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# OPENROUTER - Claude API Access
# Get from: https://openrouter.ai/ → Settings → API Keys
# ============================================================================
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# GOOGLE MAPS API - Business Lead Scraping
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Make sure to enable Places API and Maps API
# ============================================================================
GOOGLE_MAPS_KEY=AIzaSyD_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# RESEND - Email Sending
# Get from: https://resend.com/ → API Keys
# ============================================================================
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# HUGGINGFACE - Agent Deployment
# Get from: https://huggingface.co/settings/tokens
# ============================================================================
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_USERNAME=your-username

# ============================================================================
# PAKISTAN PAYMENT METHODS
# For JazzCash: Register at https://www.jazzcash.com.pk/
# For EasyPaisa: Register at https://www.easypaisa.com.pk/
# ============================================================================
JAZZCASH_MERCHANT_CODE=xxxxx
JAZZCASH_MERCHANT_PASSWORD=xxxxx
JAZZCASH_ACCOUNT_NUMBER=03334567890

EASYPAISA_STORE_ID=xxxxx
EASYPAISA_STORE_PASSWORD=xxxxx

# ============================================================================
# YOUR CONTACT DETAILS - For Outreach
# Use format: +92-3XX-XXXXXXX (Pakistani phone with country code)
# ============================================================================
YOUR_WHATSAPP_PHONE=+92334XXXXXXX
YOUR_WHATSAPP_NAME=Ahmed (or your name)
YOUR_EMAIL=your-email@gmail.com
YOUR_BUSINESS_NAME=TheDevDrive
YOUR_BUSINESS_LOCATION=Sahiwal, Punjab, Pakistan

# ============================================================================
# PRICING & CONFIGURATION
# ============================================================================
STANDARD_PRICE_PKR=15000
PREMIUM_PRICE_PKR=25000
DELIVERY_DAYS=7
PAYMENT_UPFRONT_PERCENTAGE=50

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================
NODE_ENV=production
HF_SPACE_NAME=thedevdrive-sahiwal
HF_SPACE_URL=https://huggingface.co/spaces/YOUR_USERNAME/thedevdrive-sahiwal
SERVER_PORT=7860

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000
DATABASE_RETRY_ATTEMPTS=3

# ============================================================================
# API RATE LIMITING
# ============================================================================
OPENROUTER_RATE_LIMIT=100  # Requests per minute
GOOGLE_MAPS_RATE_LIMIT=50  # Requests per minute
RESEND_RATE_LIMIT=100      # Emails per minute

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info             # debug, info, warn, error
SENTRY_DSN=                # Optional: Sentry error tracking

# ============================================================================
# WORKFLOW TIMING
# ============================================================================
LEAD_SCRAPE_INTERVAL=43200    # 12 hours (in seconds)
AUDIT_RUN_INTERVAL=28800      # 8 hours
EMAIL_BATCH_SIZE=100          # Emails per batch
WHATSAPP_BATCH_SIZE=10        # WhatsApp per batch
CALL_COACH_ENABLED=true

# ============================================================================
# MOCK DATA (For Testing - Set to false in production)
# ============================================================================
USE_MOCK_DATA=false
MOCK_LEADS_COUNT=100
MOCK_AUDITS_COUNT=50

# ============================================================================
# INSTRUCTIONS FOR SETUP
# ============================================================================
# 1. Create accounts on all 8 services (see SETUP_GUIDE.md)
# 2. Copy-paste your API keys below
# 3. Save as .env file in project root
# 4. Run: npm install
# 5. Run: npm start
#
# ⚠️ SECURITY CHECKLIST:
# ☐ Add .env to .gitignore (prevent accidental commits)
# ☐ Keep API keys secret - never share
# ☐ Rotate keys monthly
# ☐ Use strong passwords for accounts
# ☐ Enable 2FA on all accounts
# ============================================================================
